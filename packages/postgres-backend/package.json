{
  "name": "@shepherdorg/postgres-backend",
  "version": "6.0.2",
  "description": "Postgres backend for shepherd state store",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "bluebird": "^3.7.2",
    "lodash": "^4.18.1",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "@shepherdorg/metadata": "^6.0.2",
    "@shepherdorg/state-store": "^6.0.2"
  },
  "devDependencies": {
    "@shepherdorg/metadata": "^6.0.2",
    "@shepherdorg/state-store": "^6.0.2",
    "@shepherdorg/storage-backend-tester": "^6.0.2",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "yarn start-postgres",
    "test": "yarn integrationtest",
    "posttest": "yarn kill-postgres",
    "integrationtest": "SHEPHERD_PG_PORT=54321 node --require ts-node/register --test --test-concurrency=1 \"**/*.integrationtest.ts\"",
    "itdd": "SHEPHERD_PG_PORT=54321 node --require ts-node/register --watch --test \"**/*.integrationtest.ts\"",
    "prepublishOnly": "yarn build",
    "start-postgres": "docker run --rm --name postgres-it -e POSTGRES_PASSWORD=mysecretpassword -d -p 54321:5432 postgres && sleep 1",
    "kill-postgres": "docker rm -f postgres-it"
  }
}
