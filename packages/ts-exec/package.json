{
  "name": "@shepherdorg/ts-exec",
  "version": "6.0.1",
  "description": "Promise based command execution. With buffer control, fairly good tests and a test double.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "tdd": "node --require ts-node/register --watch --test \"src/**/*.spec.ts\"",
    "build": "tsc",
    "prepublishOnly": "yarn build && yarn test"
  },
  "keywords": [
    "exec",
    "cmd",
    "typescript",
    "command"
  ],
  "dependencies": {
    "@shepherdorg/logger": "^6.0.1"
  },
  "author": "Guðlaugur S. Egilsson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
