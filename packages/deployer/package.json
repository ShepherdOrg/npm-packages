{
  "name": "@shepherdorg/deployer",
  "version": "6.0.1",
  "description": "Deployer application",
  "main": "dist/shepherd.js",
  "engines": {
    "node": ">=8"
  },
  "dependencies": {
    "@shepherdorg/docker-image-metadata-loader": "^6.0.1",
    "@shepherdorg/filestore-backend": "^6.0.1",
    "@shepherdorg/hbs-template": "^6.0.1",
    "@shepherdorg/metadata": "^6.0.1",
    "@shepherdorg/nano-inject": "^6.0.1",
    "@shepherdorg/postgres-backend": "^6.0.1",
    "@shepherdorg/state-store": "^6.0.1",
    "@shepherdorg/ts-exec": "^6.0.1",
    "@shepherdorg/ui-push": "^6.0.1",
    "@types/diff": "^4.0.2",
    "@types/js-yaml": "^3.12.10",
    "array-flat-polyfill": "^1.0.1",
    "array.prototype.flatmap": "^1.3.3",
    "bluebird": "^3.7.2",
    "chalk": "^4.1.2",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.7.1",
    "handlebars": "^4.7.10",
    "js-yaml": "^3.15.2",
    "lodash": "^4.18.1",
    "oops-error": "^2.6.3",
    "prompt": "^1.3.0"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.42",
    "@types/node": "^22.10.0",
    "nyc": "^18.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build-test-images": "cd src/integratedtest/testimages && ./build-test-images.sh",
    "start-postgres": "docker run --rm --name postgres -e POSTGRES_PASSWORD=mysecretpassword -d -p 5432:5432 postgres",
    "kill-postgres": "docker stop postgres",
    "specs": "node --require ts-node/register --require ./src/test-tools/test-env.setup.ts --test \"src/**/*.spec.ts\"",
    "coverage": "TS_NODE_COMPILER_OPTIONS='{\"removeComments\":false}' nyc node --require ts-node/register --require source-map-support/register --require ./src/test-tools/test-env.setup.ts --test \"src/**/*.spec.ts\"",
    "tdd": "node --require ts-node/register --require ./src/test-tools/test-env.setup.ts --watch --test \"src/**/*.spec.ts\"",
    "integratedtest": "yarn build && yarn build-test-images && node --require ts-node/register --require ./src/test-tools/test-env.setup.ts --test \"dist/integratedtest/**/*.integratedtest.js\"",
    "compile-in-background": "tsc -w > /dev/null &",
    "itdd": "npm run compile-in-background && node --require ts-node/register --require ./src/test-tools/test-env.setup.ts --watch --test \"src/**/*.integratedtest.ts\"",
    "test": "yarn specs",
    "build": "tsc && chmod +x dist/shepherd.js",
    "prepublishOnly": "yarn build && yarn test"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "testbin/**",
      "coverage/**",
      "dist/**",
      "**/*.d.ts",
      "**/*.spec.ts"
    ],
    "reporter": [
      "html"
    ],
    "all": true
  }
}
