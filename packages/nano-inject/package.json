{
  "name": "@shepherdorg/nano-inject",
  "version": "6.0.2",
  "description": "Minimalistic dependency injection library...",
  "keywords": [
    "dependency injection",
    "typescript"
  ],
  "author": "Guðlaugur S. Egilsson <gulli@kolibri.is>",
  "homepage": "",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShepherdOrg/shepherd"
  },
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf dist",
    "ci": "yarn clean && yarn test && yarn build && yarn format-verify",
    "e2etest": "node --require ts-node/register --test --test-concurrency=1 \"**/*.e2e.ts\"",
    "e2etdd": "node --require ts-node/register --watch --test --test-concurrency=1 \"**/*.e2e.ts\"",
    "test": "node --require ts-node/register --test \"**/*.spec.ts\"",
    "tdd": "node --require ts-node/register --watch --test \"**/*.spec.ts\"",
    "prepush": "yarn ci",
    "format": "prettier --write 'lib/**/*.{ts,js}'",
    "format-verify": "prettier -l 'lib/**/*.{ts,js}'",
    "prepublishOnly": "yarn build && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^1.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
