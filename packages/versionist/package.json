{
  "name": "@shepherdorg/versionist",
  "version": "6.0.2",
  "description": "Creates or prefers version for shepherd docker building",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "versionist": "dist/versionist.js"
  },
  "engines": {
    "node": ">=8"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "specs": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "coverage": "TS_NODE_COMPILER_OPTIONS='{\"removeComments\":false}' nyc node --require ts-node/register --require source-map-support/register --test \"src/**/*.spec.ts\"",
    "tdd": "node --require ts-node/register --watch --test \"src/**/*.spec.ts\"",
    "integratedtest": "yarn build && yarn build-test-images && node --require ts-node/register --test \"dist/integratedtest/**/*.integratedtest.js\"",
    "compile-in-background": "tsc -w > /dev/null &",
    "test": "yarn specs",
    "build": "tsc && chmod +x dist/versionist.js",
    "prepublishOnly": "yarn build && yarn test"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "testbin/**",
      "coverage/**",
      "dist/**",
      "**/*.d.ts",
      "**/*.spec.ts"
    ],
    "reporter": [
      "html"
    ],
    "all": true
  }
}
